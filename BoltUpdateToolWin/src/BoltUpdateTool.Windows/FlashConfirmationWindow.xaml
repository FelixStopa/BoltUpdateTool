<Window x:Class="BoltUpdateTool.Windows.FlashConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm firmware update"
        Icon="Assets/BoltUpdateTool.ico"
        Width="540"
        Height="330"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="21"
                   FontWeight="SemiBold"
                   Foreground="#FFB91C1C"
                   Text="Write both firmware images?" />
        <TextBlock Grid.Row="1"
                   Margin="0,14,0,0"
                   TextWrapping="Wrap"
                   Text="The receiver will enter its bootloader. The application and radio/secondary images will be written together. Once transfer begins, do not unplug the receiver." />
        <TextBlock Grid.Row="2"
                   Margin="0,14,0,6"
                   FontWeight="SemiBold"
                   Text="Type FLASH to confirm:" />
        <TextBox x:Name="ConfirmationText"
                 Grid.Row="3"
                 Height="32"
                 VerticalAlignment="Top"
                 FontFamily="Consolas"
                 FontSize="15"
                 TextChanged="ConfirmationText_TextChanged" />
        <StackPanel Grid.Row="4"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="100"
                    Padding="12,7"
                    IsCancel="True"
                    Content="Cancel" />
            <Button x:Name="ConfirmButton"
                    MinWidth="150"
                    Margin="10,0,0,0"
                    Padding="12,7"
                    Background="#FFB91C1C"
                    Foreground="White"
                    FontWeight="SemiBold"
                    IsDefault="True"
                    IsEnabled="False"
                    Click="ConfirmButton_Click"
                    Content="Start update" />
        </StackPanel>
    </Grid>
</Window>
