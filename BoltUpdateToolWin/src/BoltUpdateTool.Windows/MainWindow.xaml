<Window x:Class="BoltUpdateTool.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bolt Receiver Firmware Updater"
        Icon="Assets/BoltUpdateTool.ico"
        Width="900"
        Height="760"
        MinWidth="720"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Background="#FFF5F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#FF1F2937" Padding="24,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Foreground="White"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Text="Bolt Receiver Firmware Updater" />
                    <TextBlock Margin="0,5,0,0"
                               Foreground="#FFCBD5E1"
                               Text="Firmware updater for Logitech Bolt 046D:C548 · Bootloader 046D:AB07" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="#FFCBD5E1">
                        <Run Text="Felix Stopa · " />
                        <Hyperlink Foreground="#FF93C5FD"
                                   NavigateUri="https://felix.stopa.net"
                                   RequestNavigate="HomepageLink_RequestNavigate">felix.stopa.net</Hyperlink>
                    </TextBlock>
                </StackPanel>
                <Button x:Name="RefreshButton"
                        Grid.Column="1"
                        MinWidth="130"
                        Margin="20,0,0,0"
                        Padding="16,9"
                        Click="RefreshButton_Click"
                        Content="Refresh" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Padding="18"
                    Background="White"
                    BorderBrush="#FFE2E8F0"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="StatusIndicator"
                             Width="13"
                             Height="13"
                             Margin="0,4,12,0"
                             VerticalAlignment="Top"
                             Fill="#FF94A3B8" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="StatusText"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Text="Not checked yet" />
                        <TextBlock x:Name="DeviceText"
                                   Margin="0,4,0,0"
                                   Foreground="#FF475569"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <GroupBox Grid.Row="1"
                      Margin="0,18,0,0"
                      Padding="10"
                      Header="Firmware information">
                <DataGrid x:Name="FirmwareGrid"
                          MinHeight="135"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="80" Header="Entity" Binding="{Binding Index}" />
                        <DataGridTextColumn Width="*" Header="Type" Binding="{Binding KindDescription}" />
                        <DataGridTextColumn Width="2*" Header="Version" Binding="{Binding Version}" />
                        <DataGridCheckBoxColumn Width="90" Header="Active" Binding="{Binding Active}" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Grid.Row="2"
                      Margin="0,18,0,0"
                      Padding="10"
                      MaxHeight="190"
                      Header="Firmware package">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="FirmwareSelectionText"
                                   FontWeight="SemiBold"
                                   Text="No firmware selected" />
                        <TextBlock x:Name="FirmwareFilesText"
                                   Margin="0,4,12,0"
                                   Foreground="#FF475569"
                                   Text="Select exactly one application and one radio/secondary .dfu file."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="SelectFirmwareButton"
                                MinWidth="145"
                                Padding="12,7"
                                Click="SelectFirmwareButton_Click"
                                Content="Select DFU files" />
                        <Button x:Name="StartUpdateButton"
                                MinWidth="155"
                                Margin="10,0,0,0"
                                Padding="12,7"
                                Background="#FFB91C1C"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Click="StartUpdateButton_Click"
                                Content="Write firmware"
                                IsEnabled="False" />
                    </StackPanel>

                    <TextBlock x:Name="UpdateStageText"
                               Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Margin="0,12,0,0"
                               Foreground="#FF9A3412"
                               FontWeight="SemiBold"
                               MaxHeight="44"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                    <ProgressBar x:Name="UpdateProgress"
                                 Grid.Row="2"
                                 Grid.ColumnSpan="2"
                                 Height="16"
                                 Margin="0,10,0,0"
                                 Minimum="0"
                                 Visibility="Collapsed" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="3"
                      Margin="0,18,0,0"
                      Padding="10"
                      MinHeight="180"
                      Header="Diagnostic log">
                <ListBox x:Name="LogList"
                         ItemsSource="{Binding LogLines}"
                         FontFamily="Consolas"
                         FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </GroupBox>
        </Grid>
    </Grid>
</Window>
